{
  "name": "maths-king",
  "version": "1.0.0",
  "private": true,
  "description": "Maths King - scan, solve, understand.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:engine": "tsc -p tsconfig.selftest.json",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "selftest": "npm run build:engine && node .selftest/scripts/selftest.js",
    "test": "npm run selftest",
    "dbg": "npm run build:engine && node .selftest/scripts/dbg.js",
    "db:reset": "npm run build:scripts && node --disable-warning=ExperimentalWarning .scripts/scripts/reset-db.js",
    "db:seed": "npm run build:scripts && node --disable-warning=ExperimentalWarning .scripts/scripts/seed-db.js"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "^0.18.9",
    "lucide-react": "0.474.0",
    "next": "^15.5.26",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.0",
    "sonner": "1.7.2",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}

