# ---- Core -------------------------------------------------------------------
# Secret used to sign session JWTs (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string

# Public base URL of the app (used for links, cookies, CORS)
APP_URL=http://localhost:3000

# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=admin@mathsking.app

# ---- Database ---------------------------------------------------------------
# Uses the built-in Node SQLite driver (node:sqlite) by default.
# Set DATABASE_URL to switch to a PostgreSQL/Supabase adapter in the future.
DATABASE_URL=file:./data/mathsking.db
DATABASE_DRIVER=sqlite

# ---- Storage ----------------------------------------------------------------
# Where uploaded images are persisted. "local" writes to ./data/uploads
STORAGE_DRIVER=local
STORAGE_URL=file:./data/uploads
MAX_IMAGE_BYTES=5242880

# ---- AI provider ------------------------------------------------------------
# The AI layer is provider-agnostic. Configure exactly one provider below.
# Leave every provider blank to run on the built-in offline solver engine
# (fully functional for arithmetic, algebra, quadratics, calculus, statistics...).
AI_PROVIDER=off
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_VISION_MODEL=
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=2400
AI_TEMPERATURE=0.2

# OpenAI-compatible (also works with Groq, Together, OpenRouter, Ollama...)
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gpt-4o-mini

# Anthropic
# AI_PROVIDER=anthropic
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_MODEL=claude-3-5-sonnet-latest

# Google Gemini
# AI_PROVIDER=google
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_MODEL=gemini-2.0-flash

# OpenAI-compatible local runtime (Ollama / LM Studio)
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_API_KEY=ollama

# ---- OCR / vision -----------------------------------------------------------
# "auto"   -> use the AI vision model when configured, else the on-device engine
# "ai"     -> require the AI vision model
# "local"  -> force the on-device engine
OCR_MODE=auto
OCR_MAX_IMAGE_BYTES=5242880

# ---- Payments (modular, intentionally not wired to a provider yet) ---------
# PAYMENT_PROVIDER=stripe
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_PRICE_PREMIUM_MONTHLY=

# ---- Logging ----------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info
